# OpenCode executor and improvement channel: provider/model IDs.
# For Qwen execution, only HARNESS2_IMPROVER_MODEL is needed from this pair.
HARNESS2_SOLVER_MODEL=
HARNESS2_IMPROVER_MODEL=

# Vertex deployments only.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Existing benchmark judge (a bare model ID).
HARNESS2_JUDGE_MODEL=
HARNESS2_JUDGE_BASE_URL=
HARNESS2_JUDGE_API_KEY=

# Experimental Qwen Code executor: JobBench only, OpenAI Chat Completions.
HARNESS2_QWEN_MODEL=
HARNESS2_QWEN_BASE_URL=
HARNESS2_QWEN_API_KEY=

# Optional Codex Responses endpoint.
HARNESS2_CODEX_MODEL=
HARNESS2_CODEX_BASE_URL=
HARNESS2_CODEX_CONTAINER_URL=
HARNESS2_CODEX_API_KEY=

# Use a distinct root when changing experiment configuration.
HARNESS2_RUNS_DIR=
